# Hadoop
CLUSTER_NAME=test

# Spark - Master
SPARK_MODE=master
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_HOME=/opt/spark
PYSPARK_PYTHON=python3
PYSPARK_DRIVER_PYTHON=python3

# Spark - Workers
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_PORT_1=7081
SPARK_WORKER_WEBUI_PORT_1=8081
SPARK_WORKER_PORT_2=7082
SPARK_WORKER_WEBUI_PORT_2=8082

# Iceberg
SPARK_ICEBERG_CATALOG=hadoop_catalog
SPARK_ICEBERG_WAREHOUSE=hdfs://dists-hdfs-namenode:8020/user/hive/warehouse
SPARK_ICEBERG_NAMESPACE=raw

# Source system ostgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# Jobs - Clickstream Generator
POSTGRES_HOST=srcs-ecommerce-postgres
POSTGRES_PORT=5432
SIMULATOR_POSTGRES_DB=customer_churn
POSTGRES_ADMIN_DB=postgres
CLICKSTREAM_TABLE=clickstream
ECOMMERCE_TABLE=ecommerce
CHURN_CUSTOMERS_TABLE=customers
CHURN_ORDERS_TABLE=orders
BATCH_SIZE=100
INTERVAL_SECONDS=60
CHURN_SEED_CUSTOMERS=1000
CHURN_SEED_DAYS=120
CHURN_ORDER_BATCH_SIZE=250
BASE_CHURN_RATE=0.15
SIMULATOR_RANDOM_SEED=42

# MinIO / MLflow
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_VERSION=v2.14.3
MLFLOW_PORT=5001
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_MINIO_BUCKET=mlflow
AWS_DEFAULT_REGION=us-east-1

# TensorFlow Serving
TFSERVING_VERSION=2.14.1
TFSERVING_MODEL_NAME=half_plus_two
TFSERVING_MODEL_BASE_PATH=/models/production
TFSERVING_GRPC_PORT=8500
TFSERVING_REST_PORT=8501
