<!-- Put site-specific property overrides in this file. -->
<!-- The error java.lang.IllegalStateException: Queue configuration missing child queue names for root occurs when the YARN Capacity Scheduler is enabled but cannot find the mandatory list of child queues under the system's predefined root queue. This typically prevents the Apache Hadoop ResourceManager from starting correctly.  -->
<configuration>
       <property>
        <name>yarn.scheduler.capacity.root.queues</name>
        <value>default</value>
      </property>
    <property>
      <name>yarn.scheduler.capacity.root.default.capacity</name>
      <value>100</value>
    </property>
</configuration>
